# Copie este arquivo para .env.local e preencha com suas credenciais do Supabase
# Settings → API no painel do Supabase

# Usadas no frontend (ficam no bundle — use apenas chaves públicas)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Usadas APENAS nas Vercel API routes (nunca chegam ao browser)
# No Vercel: Project Settings → Environment Variables (sem o prefixo VITE_)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Conexão direta ao banco (usada pela API de exportação financeira)
DATABASE_URL=postgresql://postgres:[senha]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres
